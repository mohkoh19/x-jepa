# Copy this file to `.env` and fill in your values.  `rootutils` loads it
# automatically, and the container accepts it with
# `apptainer exec --env-file .env ./x-jepa.sif ...`.
#
# No credentials are needed to download the released checkpoints or to run the
# evaluation suite.  Set a Hugging Face token only if you hit anonymous Hub rate
# limits, for example while building the pretraining data shards.
#
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
